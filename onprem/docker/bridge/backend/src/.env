# ローカルの場合: python3 server.py
VOICEVOX_URL=http://localhost:50021
LANGFLOW_BASE_URL=http://localhost:7860
# コンテナの設定は docker-compose.yaml に記述
# make.d/.env よりも優先度が高い
#VOICEVOX_URL=http://voicevox:50021
#LANGFLOW_BASE_URL=http://langflow:7860

LANGFLOW_FLOW_ID=gemini-pg
LANGFLOW_STATE_FLOW_ID=state
LANGFLOW_TIMEOUT_SEC=20
LANGFLOW_COMPONENT_GEMINI_AI=gemini-ai
LANGFLOW_COMPONENT_GEMINI_EMBEDDING=gemini-embedding

# ========================================
# Auth 後に取得して渡す設計
# ----------------------------------------
# https://aistudio.google.com/app/api-keys より取得
LANGFLOW_GOOGLE_API_KEY=AQ.aaaaaaaaaaaaa-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
LANGFLOW_GEMINI_MODEL_NAME=gemini-3.5-flash
# ========================================

FETCH_STATUS_API=false

WEBSOCKET_PORT=8765

VOICEVOX_SPEAKER_ID=89
VOICEVOX_SPEED_SCALE=1.5
