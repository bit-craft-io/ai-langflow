## Set to true to enable development container
#__DEV_CONTAINER=false
__DEV_CONTAINER=true

## Ollamaで使用するモデル（チャット用/埋め込み用）
#__OLLAMA_MODEL=llama3.2:3b
__OLLAMA_MODEL=llama3.2:1b
__WARMUP_MODEL=bge-m3

## Docker
__DOCKER_ROOT_FIRECRAWL=docker/firecrawl
__DOCKER_ROOT_SEARXNG=docker/searxng
__DOCKER_ROOT_OLLAMA=docker/ollama
__DOCKER_ROOT_VOICEVOX=docker/voicevox
__DOCKER_ROOT_LANGFLOW=docker/langflow
__DOCKER_ROOT_PGVECTOR=docker/pgvector
__DOCKER_ROOT_BRIDGE=docker/bridge

__UNITY_PROJECT_DIR=/mnt/s/risuna
__UNITY_BACKUP_DIR=client/unity/backup
__UNITY_INIT_DIR=client/unity/init

# Langflow
__LANGFLOW_API_KEY=sk-aaaaaaaaaaaaaa-bbbbbbbbbbbbbbbbbbbbbbbbbbbb
